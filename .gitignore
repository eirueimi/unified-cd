# W4 rig: the agent access/refresh credential the enrollment interposer serves.
# Live `uca_`/`ucr_` material — must never be committed.
# Regenerate with test/edgecase/tools/w4/w4-mint-credential.sh.
test/edgecase/tools/w4/w4-agent-credentials.json
test/edgecase/tools/w4/.w4creds.tmp
