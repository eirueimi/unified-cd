# unified-cd production compose: required settings.
# cp deployments/docker/.env.example deployments/docker/.env, then replace every <placeholder>.
# Compose refuses to start while any of the required values below is unset.
# Never commit the filled-in .env file.

# Admin token for the API, CLI and Web UI. The controller refuses to start with
# the published default token.   openssl rand -hex 32
UNIFIED_TOKEN=<random-admin-token>

# PostgreSQL password. Use hex only: it is embedded in a connection URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=<random-hex-password>

# Garage (bundled S3-compatible object store).
#   GARAGE_RPC_SECRET must be exactly 64 hex chars: openssl rand -hex 32
GARAGE_RPC_SECRET=<64-hex-chars>
#   openssl rand -hex 12
GARAGE_S3_ACCESS_KEY=<random-access-key>
#   openssl rand -hex 32
GARAGE_S3_SECRET_KEY=<random-secret-key>

# Secret-encryption key file (KEK), path relative to deployments/docker/ or
# absolute. Create it once and back it up:
#   unified-cli keygen --out deployments/docker/kek
UNIFIED_KEK_FILE=./kek

# ---- Optional ----
# Pin a release instead of :latest.
# UNIFIED_CD_VERSION=v0.0.3
# UNIFIED_AGENT_ID=docker-agent-1
# UNIFIED_AGENT_LABELS=kind:docker,pool:default
# SSO (see docs/operator-manual/identity-providers.md).
# UNIFIED_OIDC_ISSUER=
# UNIFIED_OIDC_CLIENT_ID=
# UNIFIED_OIDC_CLIENT_SECRET=
